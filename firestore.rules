rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedOwner() {
      return isVerifiedUser() &&
        (request.auth.token.email == 'saraswatiedutrust01@gmail.com' ||
         request.auth.token.email == 'secratary@saraswatiedutrust.online');
    }

    function isAdmin() {
      return isVerifiedUser() &&
        (isBootstrappedOwner() ||
         exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid', 'email', 'displayName', 'designation', 'role', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'email', 'displayName', 'designation', 'role', 'status', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 140 &&
        data.displayName is string && data.displayName.size() <= 120 &&
        data.designation is string && data.designation.size() <= 120 &&
        data.role in ['admin', 'editor', 'content_manager', 'viewer'] &&
        data.status in ['active', 'pending', 'revoked'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAccessRequest(data) {
      return data.keys().hasAll([
          'uid', 'email', 'displayName', 'designation', 'requestedRole', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'email', 'displayName', 'designation', 'requestedRole', 'status', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 140 &&
        data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 120 &&
        data.designation is string && data.designation.size() >= 2 && data.designation.size() <= 120 &&
        data.requestedRole in ['editor', 'content_manager'] &&
        data.status in ['pending', 'approved', 'rejected'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAdminMarker(data) {
      return data.keys().hasAll(['uid', 'email', 'grantedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'grantedAt']) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 140 &&
        data.grantedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());

      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        isValidUserProfile(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        ((isBootstrappedOwner() && incoming().role == 'admin' && incoming().status == 'active') ||
         (incoming().role == 'viewer' && incoming().status == 'pending'));

      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (isAdmin() ||
         (request.auth.uid == userId &&
          incoming().role == existing().role &&
          incoming().status == existing().status &&
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'designation', 'updatedAt'])));

      allow delete: if isAdmin() && isValidId(userId);
    }

    match /access_requests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId) && (request.auth.uid == requestId || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());

      allow create: if isVerifiedUser() &&
        isValidId(requestId) &&
        request.auth.uid == requestId &&
        isValidAccessRequest(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidId(requestId) &&
        isValidAccessRequest(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (isAdmin() ||
         (request.auth.uid == requestId &&
          existing().status == 'pending' &&
          incoming().status == 'pending' &&
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'designation', 'requestedRole', 'updatedAt'])));

      allow delete: if isAdmin() && isValidId(requestId);
    }

    match /admins/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      allow create: if isAdmin() &&
        isValidId(userId) &&
        isValidAdminMarker(incoming()) &&
        incoming().uid == userId &&
        incoming().grantedAt == request.time;

      allow update: if isAdmin() &&
        isValidId(userId) &&
        isValidAdminMarker(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().grantedAt == existing().grantedAt;

      allow delete: if isAdmin() && isValidId(userId);
    }
  }
}
